CLAUDE.md

# ── Large binary data (never commit) ─────────────────────────────────────────
/dataset/
/data/*
/outputs/
checkpoints/
logs/

# ── Model weights (too large for git — use git-lfs or copy manually) ──────────
models/*.pth
models/*.pth.tar
models/*.pt
models/*.onnx

# ── Fetched on first use by the S3Diff upscaling backend ─────────────────────
S3Diff/
weights/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.pyd
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.so
*.dylib

# ── Virtual envs / conda ──────────────────────────────────────────────────────
.venv/
venv/
env/
.conda/

# ── Claude Code ──────────────────────────────────────────────────────────────
.claude/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Temp / test artifacts ─────────────────────────────────────────────────────
*.tmp
*.zip
tmp/

# ── Video / image files (never commit binaries to repo) ───────────────────────
*.mp4
# Exception: sample clip for notebooks/pipeline_demo.ipynb, small enough to
# commit directly so the demo runs immediately after a fresh clone.
!/data/bird1.mp4
*.avi
*.mov
*.mkv
*.png
!/docs/images/*.png
*.jpg
*.jpeg
*.webp

# ── Markdown reports / scratch notes ──────────────────────────────────────────
weekly_report*.md
requests.md

# ── Misc root-level artifacts ─────────────────────────────────────────────────
samples/
main

# ── DGX run bookkeeping (use-dgx skill) ──────────────────────────────────────
.dgx/

# ── Interaction log (local only) ─────────────────────────────────────────────
llm_interaction_log.md
